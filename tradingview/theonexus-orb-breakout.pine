// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © hundredtoamillion (original opening-range indicator) — extended with Shanghai
// session, webhook alert firing, and order-block-based stops for Theonexus Trading
// Oracle. The order-block detection is a simplified port of "Price Action Toolkit
// Lite [UAlgo]" (© UAlgo), licensed CC BY-NC-SA 4.0:
// https://creativecommons.org/licenses/by-nc-sa/4.0/ — noncommercial use only, and if
// you ever share/publish this script it must carry that same license + credit.
//
// This is 1 of 2 companion scripts for Theonexus Trading Oracle:
//   - Theonexus - ORB Breakout   (this file) — session opening-range breakout
//   - Theonexus - OB Reversal    (separate file) — order-block rejection reversal
// (Two further standalone scripts, ORB 3-Candle Confirmation and Algo 2 First-Touch
// Zones, were built separately and are now merged into/superseded by this file's
// entry logic below — kept as reference, not required alongside this one.)
//
// !! KEEP THIS SCRIPT PRIVATE — NEVER PUBLISH IT !!
// Once you fill in the webhook secret and/or PickMyTrade credentials below, this
// script contains those in plain text inside every alert message.
//
// MERGED: the entry trigger is now the 3-candle confirmation sequence (candle 1 =
// breakout close outside the ORB; candle 2 = one-time continuation check; if not
// continuing, every candle from there on is checked for a close back inside the
// ORB, indefinitely, until the entry cutoff) instead of firing instantly on the
// first close outside the range. VWAP is now a hard directional gate (price above
// VWAP -> only longs eligible, below -> only shorts), replacing the EMA trend
// filter that used to do that job — the order-block bounce override still works
// exactly as before, just overriding VWAP now instead of the EMA read. Session
// re-entry is gone: hard one-trade-per-session cap, matching the 3-candle spec.
// Stops stay order-block-based and the target stays a fixed tick count — this
// script's existing strengths, kept rather than replaced with the simpler
// opposite-side-of-ORB stop / R:R target the 3-candle version used standalone.
//
// STRATEGY: 1-min opening-range breakout across Tokyo/Shanghai/London/New York
// sessions. Opening range = the first real 1-minute candle of each session,
// locked via request.security regardless of chart timeframe. On a close outside
// the range (candle 1), candle 2 checks once whether price is still closing
// outside in the same direction — if so, continuation is confirmed and the entry
// fires on candle 3. If not, every candle from then on (no fixed cutoff at candle
// 3) is checked for a close back inside the range; the first one that happens is
// a failed-breakout reversal, and the entry fires on that same candle, opposite
// direction, if VWAP allows it. Only one trade fires per session — once taken,
// nothing else can start until the next session, and no new breakout can even
// start arming past the configurable entry-cutoff time. Any position still open
// past the configurable forced-flat time is closed regardless of where its stop/
// target sit.
//
// Both the instrument symbol AND tick size sent to the webhook are read automatically
// from the chart (syminfo.root / syminfo.mintick) — there are no manual per-instrument
// fields to forget to update.
//
// Sizes contracts the same way OB Reversal does (8 for MGC/MNQ, 1 for HG, picked
// automatically from the chart's instrument) and sends that in the entry alert, so the
// dashboard computes real ticks * tick value * contracts P&L. This is also what the
// trailing stop arms off of: once floating profit passes $160 (configurable), the stop
// starts trailing behind price by a fixed tick distance (also configurable) instead of
// sitting at the original stop. The target itself is untouched.
//
// One open position per instrument at a time, enforced by the dashboard's webhook —
// this script and the OB Reversal script can't both hold a position on the same
// instrument simultaneously; a second entry attempt while one is already open is
// rejected server-side rather than opening a conflicting long+short.
//
// A breakout entry is also skipped entirely if the close is currently sitting inside
// a still-valid order block or sell block (as opposed to wicking in and rejecting
// back out — that's the bounce override, a different thing). Checked at the moment
// of entry firing (candle 3, or the reversal-confirmation candle), not at the
// original breakout candle. Toggleable under "Order Blocks".
//
// The `contracts` value sent to the DASHBOARD webhook (orbContracts, fixed at 8 or 1)
// is only a BASELINE — the dashboard's own webhook overrides it for MGC/MNQ with a
// live risk-scaled count. The PickMyTrade relay below uses this same baseline count
// directly (real execution doesn't get the dashboard's post-hoc scaling).

//@version=5

strategy("Theonexus - ORB Breakout", overlay = true, default_qty_type = strategy.fixed,
     default_qty_value = 1, calc_on_every_tick = false, process_orders_on_close = true,
     initial_capital = 50000, currency = currency.USD)

ref_res = ""
tmzn = input(defval="GMT+7", title = "Timezone")

// ── Webhook config ──────────────────────────────────────────────────────────
webhookSecret = input.string("REPLACE_WITH_YOUR_WEBHOOK_SECRET", title = "TradingView Webhook Secret", group = "Webhook")
// Read directly from the chart instead of manual inputs — see header note above.
symbolChoice  = syminfo.root
tickSize      = syminfo.mintick
targetTicks   = input.int(10, title = "First-entry target (ticks)", minval = 1, group = "Webhook")
breakoutWindowMinutes = input.int(15, title = "Entry cutoff (minutes after session open — no NEW breakout can start arming past this)", minval = 1, group = "Webhook")
forceFlatMinutes = input.int(120, title = "Forced flat (minutes after session open — any open position closes here regardless of stop/target)", minval = 1, group = "Webhook")

// Real dollar-per-tick value and contract sizing, same convention as the OB Reversal
// script — needed so the trailing stop below can arm off an actual dollar profit
// figure instead of raw ticks. Also sent in the entry alert now so the dashboard
// computes this strategy's P&L from real ticks * tick value * contracts too, instead
// of the old normalized risk-per-trade estimate.
tickDollarValue = symbolChoice == "HG" ? 12.50 : symbolChoice == "MNQ" ? 0.50 : 1.00
// Bumped 4 -> 8 (2026-09-04) per the user's own actual practice ("6 to 8 contracts
// because these are scalp moves") — HG stays at 1, unchanged.
orbContracts    = symbolChoice == "HG" ? 1 : 8

// ── PickMyTrade relay (optional, off by default) ──────────────────────────────
// When enabled, every strategy.entry()/strategy.close() call below also carries a
// PickMyTrade-shaped alert_message built from REAL computed values (symbol, side,
// contracts) — not TradingView's {{placeholder}} syntax. Create ONE TradingView
// alert on this script with condition "Order fills" pointed at PickMyTrade's
// webhook URL, and every fill sends the correct JSON automatically.
// This does NOT touch the dashboard alert() calls below, which are unchanged.
pmtEnabled   = input.bool(false, "Relay real fills to PickMyTrade", group = "PickMyTrade")
pmtToken     = input.string("", "PickMyTrade Token", group = "PickMyTrade")
pmtAccountId = input.string("", "PickMyTrade Account ID", group = "PickMyTrade")
pmtSymbol = symbolChoice == "MGC" ? "MGC1!" : symbolChoice == "HG" ? "HG1!" : "MNQ1!"

f_pmtMessage(side, qty) =>
    pmtEnabled ? '{"symbol":"' + pmtSymbol + '","data":"' + side + '","quantity":' + str.tostring(qty) + ',"token":"' + pmtToken + '","account_id":"' + pmtAccountId + '","order_type":"MKT"}' : ""

bool showTokyo    = input.bool(true, "Show Tokyo Opening Range?", group = "Opening Ranges ON/OFF")
bool showShanghai = input.bool(true, "Show Shanghai Opening Range?", group = "Opening Ranges ON/OFF")
bool showLondon   = input.bool(true, "Show London Opening Range?", group = "Opening Ranges ON/OFF")
bool showNewYork  = input.bool(true, "Show New York Opening Range?", group = "Opening Ranges ON/OFF")

tokyo    = input.session(defval = "0700-1600", title = "Tokyo Session", group = "Session Times")
shanghai = input.session(defval = "0800-1500", title = "Shanghai Session", group = "Session Times")
london   = input.session(defval = "1500-2340", title = "London Session", group = "Session Times")
newyork  = input.session(defval = "2030-0400", title = "New York Session", group = "Session Times")

// ── VWAP directional gate ────────────────────────────────────────────────────
// Replaces the old EMA trend filter: price above VWAP -> only longs eligible,
// below -> only shorts eligible. The order-block bounce override further down is
// the one thing allowed to override this.
vwapFilterEnabled = input.bool(true, "VWAP Filter ON/OFF", group = "VWAP")
vwapVal = ta.vwap(hlc3)
plot(vwapVal, color = color.new(color.aqua, 0), title = "VWAP")
bool vwapBiasLong  = not vwapFilterEnabled or close > vwapVal
bool vwapBiasShort = not vwapFilterEnabled or close < vwapVal
trendOverrideWindowBars = input.int(3, "Order block bounce override window (bars)", minval = 0, group = "VWAP")

// ── Trailing stop ─────────────────────────────────────────────────────────────
// Once a trade's floating profit passes this dollar amount, its stop starts
// trailing behind price by a fixed tick distance instead of sitting at the
// original fixed stop. Only ever tightens. The target itself is untouched.
trailArmProfit = input.float(160, "Arm trailing stop once profit exceeds ($)", group = "Trailing Stop")
trailTicks     = input.int(20, "Trail distance (ticks)", minval = 1, group = "Trailing Stop")

//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

// TK/SH/LD/NY are used only to plot session-active state on the CURRENT chart
// timeframe; the actual opening range below is computed independently from real
// 1-minute data so it stays correct no matter what timeframe you're viewing.
TK = time(ref_res, tokyo, tmzn)
SH = time(ref_res, shanghai, tmzn)
LD = time(ref_res, london, tmzn)
NY = time(ref_res, newyork, tmzn)

bool tkActive = not na(TK)
bool shActive = not na(SH)
bool ldActive = not na(LD)
bool nyActive = not na(NY)

open_bar(t) => na(t[1]) and not na(t) or t[1] < t ? 1 : 0

get_ohlc(s) =>
    // Assign persisting variables
    var float _open  = na
    var float _high  = na
    var float _low   = na
    var float _close = na

    // Update variables if new bar
    _open  := s ?
         open : nz(_open[1], open)
    _high  := s or high > _high[1] ?
         high : nz(_high[1], high)
    _low   := s or low < _low[1] ?
         low : nz(_low[1], low)
    _close := close

    // Return variables as a tuple
    [_open, _high, _low, _close]

// ── 1-minute opening range, locked to real 1-minute data via request.security ──
// so the range itself never depends on which timeframe you're viewing the chart at.
f_session1mOR(sess) =>
    tS = time(ref_res, sess, tmzn)
    sw = ta.change(open_bar(tS)) > 0
    [_o, h, l, _c] = get_ohlc(sw)
    var float orHigh = na
    var float orLow  = na
    if sw
        orHigh := h
        orLow  := l
    [orHigh, orLow, sw]

[tk_open_high, tk_open_low, tk_switch] = request.security(syminfo.tickerid, "1", f_session1mOR(tokyo))
[sh_open_high, sh_open_low, sh_switch] = request.security(syminfo.tickerid, "1", f_session1mOR(shanghai))
[ld_open_high, ld_open_low, ld_switch] = request.security(syminfo.tickerid, "1", f_session1mOR(london))
[ny_open_high, ny_open_low, ny_switch] = request.security(syminfo.tickerid, "1", f_session1mOR(newyork))

plorh = plot(showLondon and ldActive ? ld_open_high : na, color = color.new(color.blue,0), style = plot.style_circles, title = "London Opening Range High")
plorl = plot(showLondon and ldActive ? ld_open_low :na, color = color.new(color.blue,0), style = plot.style_circles, title = "London Opening Range Low")
fill(plorh, plorl, color = color.new(color.blue,55), title = "London Opening Range Fill")
pnorh = plot(showNewYork and nyActive ? ny_open_high : na, color = color.new(color.red, 0), style = plot.style_circles, title = "New York Opening Range High")
pnorl = plot(showNewYork and nyActive ? ny_open_low :na, color = color.new(color.red,0) , style = plot.style_circles, title = "New York Opening Range Low")
fill(pnorh, pnorl, color = color.new(color.red,65), title = "New York Opening Range Fill")
ptorh = plot(showTokyo and tkActive ? tk_open_high : na, color = color.new(color.yellow, 0), style = plot.style_circles, title = "Tokyo Opening Range High")
ptorl = plot(showTokyo and tkActive ? tk_open_low :na, color = color.new(color.yellow, 0), style = plot.style_circles,  title = "Tokyo Opening Range Low")
fill(ptorh, ptorl, color = color.new(color.yellow,80), title = "Tokyo Opening Range Fill")
pshh = plot(showShanghai and shActive ? sh_open_high : na, color = color.new(color.orange, 0), style = plot.style_circles, title = "Shanghai Opening Range High")
pshl = plot(showShanghai and shActive ? sh_open_low : na, color = color.new(color.orange, 0), style = plot.style_circles, title = "Shanghai Opening Range Low")
fill(pshh, pshl, color = color.new(color.orange,80), title = "Shanghai Opening Range Fill")

// ── Order blocks (simplified port of "Price Action Toolkit Lite [UAlgo]", CC BY-NC-SA
// 4.0 — https://creativecommons.org/licenses/by-nc-sa/4.0/, © UAlgo) ────────────────
obShow      = input.bool(true, "Show Order Blocks", group = "Order Blocks")
obStructLen = input.int(9, "Order Block Structure Length", group = "Order Blocks")
obKeepCount = input.int(2, "Order Blocks to Keep Visible", minval = 1, maxval = 10, group = "Order Blocks")
blockEntryInsideOb = input.bool(true, "Skip entry if price closed inside a still-valid order/sell block", group = "Order Blocks")

type orderblock
    float value
    int barStart
    int barEnd
    box block
    bool broken

var array<orderblock> bullishOrderblock = array.new<orderblock>()
var array<orderblock> bearishOrderblock = array.new<orderblock>()
var array<int> obHighValIndex = array.new<int>()
var array<int> obLowValIndex = array.new<int>()
var array<float> obHighVal = array.new_float()
var array<float> obLowVal = array.new_float()

var bool obDrawUp = false
var bool obDrawDown = false
var int obTrend = 1

obAtr = ta.atr(14)

obToUp = high[obStructLen] >= ta.highest(high, obStructLen)
obToDown = low[obStructLen] <= ta.lowest(low, obStructLen)
obTrend := obTrend == 1 and obToDown ? -1 : obTrend == -1 and obToUp ? 1 : obTrend

if ta.change(obTrend) != 0 and obTrend == 1
    array.push(obHighValIndex, time[obStructLen])
    array.push(obHighVal, high[obStructLen])
    if array.size(obLowVal) > 1
        obDrawUp := false

if ta.change(obTrend) != 0 and obTrend == -1
    array.push(obLowValIndex, time[obStructLen])
    array.push(obLowVal, low[obStructLen])
    if array.size(obHighVal) > 1
        obDrawDown := false

if array.size(obLowVal) > 1 and obDrawDown == false
    if close < array.get(obLowVal, array.size(obLowVal) - 1)
        obDrawDown := true
        if obShow
            orderblock newOb = orderblock.new()
            float maxV = 0
            int barT = na
            for i = (time - array.get(obLowValIndex, array.size(obLowValIndex) - 1) - (time - time[1])) / (time - time[1]) to 0 by 1
                if high[i] > maxV
                    maxV := high[i]
                    barT := time[i]
            newOb.barStart := barT
            newOb.barEnd := time
            newOb.broken := false
            newOb.value := maxV
            newOb.block := box.new(left = newOb.barStart, top = newOb.value - obAtr, right = newOb.barEnd, bottom = newOb.value, xloc = xloc.bar_time, bgcolor = color.new(color.red, 80), border_width = 1, border_color = color.new(color.red, 80))
            array.push(bearishOrderblock, newOb)
            if array.size(bearishOrderblock) > 20
                array.shift(bearishOrderblock)

if array.size(obHighVal) > 1 and obDrawUp == false
    if close > array.get(obHighVal, array.size(obHighVal) - 1)
        obDrawUp := true
        if obShow
            orderblock newOb = orderblock.new()
            float minV = 999999999
            int barT = na
            for i = (time - array.get(obHighValIndex, array.size(obHighValIndex) - 1) - (time - time[1])) / (time - time[1]) to 0 by 1
                if low[i] < minV
                    minV := low[i]
                    barT := time[i]
            newOb.barStart := barT
            newOb.barEnd := time
            newOb.broken := false
            newOb.value := minV
            newOb.block := box.new(left = newOb.barStart, top = newOb.value + obAtr, right = newOb.barEnd, bottom = newOb.value, xloc = xloc.bar_time, bgcolor = color.new(color.teal, 80), border_width = 1, border_color = color.new(color.teal, 80))
            array.push(bullishOrderblock, newOb)
            if array.size(bullishOrderblock) > 20
                array.shift(bullishOrderblock)

// Invalidate/remove order blocks once price closes back through them
if array.size(bullishOrderblock) > 0
    orderblock testOb = na
    int obCounter = 0
    for i = array.size(bullishOrderblock) - 1 to 0 by 1
        testOb := array.get(bullishOrderblock, i)
        if obCounter < obKeepCount
            testOb.block.set_right(time)
            if close < testOb.value
                testOb.block.delete()
                array.remove(bullishOrderblock, i)
            obCounter := obCounter + 1
        else
            testOb.block.set_right(testOb.barStart)

if array.size(bearishOrderblock) > 0
    orderblock testOb2 = na
    int obCounter2 = 0
    for i = array.size(bearishOrderblock) - 1 to 0 by 1
        testOb2 := array.get(bearishOrderblock, i)
        if obCounter2 < obKeepCount
            testOb2.block.set_right(time)
            if close > testOb2.value
                testOb2.block.delete()
                array.remove(bearishOrderblock, i)
            obCounter2 := obCounter2 + 1
        else
            testOb2.block.set_right(testOb2.barStart)

// Nearest still-valid order block below/above a price, for stop placement
f_nearestBullishOB(px) =>
    float nearest = na
    if array.size(bullishOrderblock) > 0
        for i = array.size(bullishOrderblock) - 1 to 0 by 1
            ob = array.get(bullishOrderblock, i)
            if ob.value < px and (na(nearest) or ob.value > nearest)
                nearest := ob.value
    nearest

f_nearestBearishOB(px) =>
    float nearest = na
    if array.size(bearishOrderblock) > 0
        for i = array.size(bearishOrderblock) - 1 to 0 by 1
            ob = array.get(bearishOrderblock, i)
            if ob.value > px and (na(nearest) or ob.value < nearest)
                nearest := ob.value
    nearest

// ── Skip entry if price closed inside a block (checked at the moment of firing) ──
f_closedInsideBullOb() =>
    bool inside = false
    if array.size(bullishOrderblock) > 0
        for i = array.size(bullishOrderblock) - 1 to 0 by 1
            ob = array.get(bullishOrderblock, i)
            if not ob.broken and close <= (ob.value + obAtr) and close >= ob.value
                inside := true
    inside

f_closedInsideBearOb() =>
    bool inside = false
    if array.size(bearishOrderblock) > 0
        for i = array.size(bearishOrderblock) - 1 to 0 by 1
            ob = array.get(bearishOrderblock, i)
            if not ob.broken and close <= ob.value and close >= (ob.value - obAtr)
                inside := true
    inside

bool closedInsideOb = blockEntryInsideOb and (f_closedInsideBullOb() or f_closedInsideBearOb())

// ── Order block bounce: the one exception to the VWAP gate ──────────────────
// A bounce = a rejection candle: a bar wicks into a still-valid block and CLOSES
// back outside it, same definition the OB Reversal strategy uses. When that just
// happened (within the override window below), an entry in that direction is
// allowed to fire even against the VWAP bias above.
f_touchedBullishOB() =>
    orderblock matched = na
    if array.size(bullishOrderblock) > 0
        for i = array.size(bullishOrderblock) - 1 to 0 by 1
            ob = array.get(bullishOrderblock, i)
            float obTop = ob.value + obAtr
            float obBottom = ob.value
            if na(matched) and not ob.broken and low <= obTop and high >= obBottom
                matched := ob
    matched

f_touchedBearishOB() =>
    orderblock matched = na
    if array.size(bearishOrderblock) > 0
        for i = array.size(bearishOrderblock) - 1 to 0 by 1
            ob = array.get(bearishOrderblock, i)
            float obTop = ob.value
            float obBottom = ob.value - obAtr
            if na(matched) and not ob.broken and low <= obTop and high >= obBottom
                matched := ob
    matched

touchedBullOb = f_touchedBullishOB()
touchedBearOb = f_touchedBearishOB()
// Nested `if`, not `and` — Pine evaluates both sides of `and` regardless of the
// first, so a na-guard followed by `.value` access in the same `and` still crashes.
bool bullBounceNow = false
bool bearBounceNow = false
if not na(touchedBullOb)
    bullBounceNow := close > (touchedBullOb.value + obAtr)
if not na(touchedBearOb)
    bearBounceNow := close < (touchedBearOb.value - obAtr)

var int barsSinceBullBounce = 999999
var int barsSinceBearBounce = 999999
barsSinceBullBounce := bullBounceNow ? 0 : barsSinceBullBounce + 1
barsSinceBearBounce := bearBounceNow ? 0 : barsSinceBearBounce + 1

bool bullBounceRecent = barsSinceBullBounce <= trendOverrideWindowBars
bool bearBounceRecent = barsSinceBearBounce <= trendOverrideWindowBars

bool vwapOkLong  = vwapBiasLong or bullBounceRecent
bool vwapOkShort = vwapBiasShort or bearBounceRecent

// ── 3-candle confirmation breakout, per session ──────────────────────────────
// Candle 1 = a close outside the ORB. Candle 2 = the ONE continuation check: did
// price also close outside in the same direction? If so, continuation is
// confirmed and the entry fires on candle 3. If not, every candle from then on is
// checked for a close back inside the ORB (no fixed cutoff) — the first one that
// happens is a failed-breakout reversal, entering opposite direction on that same
// candle if VWAP (or a fresh order-block bounce) allows it. One trade max per
// session; each session uses its own strategy.entry()/close() order id so the
// four sessions can never collide with each other.
f_manageBreakout(newSession, orHigh, orLow, sessionLabel, sym, tickSz, targetTk, secret, enabled, entryCutoffMin, flatMin, contracts, tickDollar, trailArmUsd, trailTk, blockIfInsideOb) =>
    var bool tradeTaken = false
    var int breakoutDir = 0
    var int barsSinceBreakout = na
    var bool continuationConfirmed = false
    var bool inLong = false
    var bool inShort = false
    var float stopPx = na
    var float targetPx = na
    var float entryPx = na
    var bool trailArmed = false
    var float sessionOpenTime = na

    if newSession
        tradeTaken := false
        breakoutDir := 0
        barsSinceBreakout := na
        continuationConfirmed := false
        trailArmed := false
        sessionOpenTime := time
        // NOT resetting inLong/inShort/stopPx/targetPx — an open position from the
        // tail end of the prior session window is still managed by its own
        // stop/target/force-flat, not silently abandoned.

    int minutesSinceOpen = na(sessionOpenTime) ? na : int((time - sessionOpenTime) / 60000)
    bool pastEntryCutoff = not na(minutesSinceOpen) and minutesSinceOpen >= entryCutoffMin
    bool pastFlatTime = not na(minutesSinceOpen) and minutesSinceOpen >= flatMin

    // ── Force-flat ──────────────────────────────────────────────────────────
    if pastFlatTime and inLong
        strategy.close(sessionLabel + "_Long", alert_message = f_pmtMessage("close", contracts))
        alert('{"secret":"' + secret + '","action":"exit","symbol":"' + sym + '","exitPrice":' + str.tostring(close, format.mintick) + ',"outcome":"CLOSED_AT_DAY_END"}', alert.freq_once_per_bar_close)
        inLong := false
    if pastFlatTime and inShort
        strategy.close(sessionLabel + "_Short", alert_message = f_pmtMessage("close", contracts))
        alert('{"secret":"' + secret + '","action":"exit","symbol":"' + sym + '","exitPrice":' + str.tostring(close, format.mintick) + ',"outcome":"CLOSED_AT_DAY_END"}', alert.freq_once_per_bar_close)
        inShort := false

    // ── Trailing stop ────────────────────────────────────────────────────────
    if inLong
        float floatingProfit = ((high - entryPx) / tickSz) * tickDollar * contracts
        if not trailArmed and floatingProfit >= trailArmUsd
            trailArmed := true
        if trailArmed
            stopPx := math.max(stopPx, high - trailTk * tickSz)
    if inShort
        float floatingProfit = ((entryPx - low) / tickSz) * tickDollar * contracts
        if not trailArmed and floatingProfit >= trailArmUsd
            trailArmed := true
        if trailArmed
            stopPx := math.min(stopPx, low + trailTk * tickSz)

    // ── Normal target/stop exit ──────────────────────────────────────────────
    if inLong and (high >= targetPx or low <= stopPx)
        float exitPx = high >= targetPx ? targetPx : stopPx
        strategy.close(sessionLabel + "_Long", alert_message = f_pmtMessage("close", contracts))
        alert('{"secret":"' + secret + '","action":"exit","symbol":"' + sym + '","exitPrice":' + str.tostring(exitPx, format.mintick) + '}', alert.freq_once_per_bar_close)
        inLong := false
    if inShort and (low <= targetPx or high >= stopPx)
        float exitPx = low <= targetPx ? targetPx : stopPx
        strategy.close(sessionLabel + "_Short", alert_message = f_pmtMessage("close", contracts))
        alert('{"secret":"' + secret + '","action":"exit","symbol":"' + sym + '","exitPrice":' + str.tostring(exitPx, format.mintick) + '}', alert.freq_once_per_bar_close)
        inShort := false

    // ── Breakout tracking / entry logic ──────────────────────────────────────
    bool longBreak = false
    bool shortBreak = false
    if not tradeTaken and enabled and not pastEntryCutoff and not na(orHigh) and not na(orLow)
        bool closedAboveOrb = close > orHigh
        bool closedBelowOrb = close < orLow
        bool closedInsideOrb = close <= orHigh and close >= orLow

        if continuationConfirmed
            // Candle 3 for a confirmed continuation.
            bool vwapOk = breakoutDir == 1 ? vwapOkLong : vwapOkShort
            if vwapOk and not blockIfInsideOb
                float entryPxC = close
                float obStop = breakoutDir == 1 ? f_nearestBullishOB(close) : f_nearestBearishOB(close)
                float stop = breakoutDir == 1 ? (na(obStop) ? orLow : obStop) : (na(obStop) ? orHigh : obStop)
                float target = breakoutDir == 1 ? entryPxC + tickSz * targetTk : entryPxC - tickSz * targetTk
                if breakoutDir == 1
                    longBreak := true
                    inLong := true
                    entryPx := entryPxC
                    stopPx := stop
                    targetPx := target
                    strategy.entry(sessionLabel + "_Long", strategy.long, qty = contracts, alert_message = f_pmtMessage("buy", contracts))
                    alert('{"secret":"' + secret + '","action":"entry","symbol":"' + sym + '","direction":"LONG","session":"' + sessionLabel + '","strategy":"1m ORB + VWAP","entryPrice":' + str.tostring(entryPxC, format.mintick) + ',"stopPrice":' + str.tostring(stop, format.mintick) + ',"targetPrice":' + str.tostring(target, format.mintick) + ',"contracts":' + str.tostring(contracts) + '}', alert.freq_once_per_bar_close)
                else
                    shortBreak := true
                    inShort := true
                    entryPx := entryPxC
                    stopPx := stop
                    targetPx := target
                    strategy.entry(sessionLabel + "_Short", strategy.short, qty = contracts, alert_message = f_pmtMessage("sell", contracts))
                    alert('{"secret":"' + secret + '","action":"entry","symbol":"' + sym + '","direction":"SHORT","session":"' + sessionLabel + '","strategy":"1m ORB + VWAP","entryPrice":' + str.tostring(entryPxC, format.mintick) + ',"stopPrice":' + str.tostring(stop, format.mintick) + ',"targetPrice":' + str.tostring(target, format.mintick) + ',"contracts":' + str.tostring(contracts) + '}', alert.freq_once_per_bar_close)
                tradeTaken := true
            breakoutDir := 0
            barsSinceBreakout := na
            continuationConfirmed := false

        else if not na(barsSinceBreakout)
            if barsSinceBreakout == 0
                // Candle 2 — the one and only continuation check for this breakout.
                bool stillOutside = breakoutDir == 1 ? closedAboveOrb : closedBelowOrb
                if stillOutside
                    continuationConfirmed := true
                    barsSinceBreakout := barsSinceBreakout + 1
                else if closedInsideOrb
                    int revDir = breakoutDir == 1 ? -1 : 1
                    bool vwapOk = revDir == 1 ? vwapOkLong : vwapOkShort
                    if vwapOk and not blockIfInsideOb
                        float entryPxR = close
                        float obStop = revDir == 1 ? f_nearestBullishOB(close) : f_nearestBearishOB(close)
                        float stop = revDir == 1 ? (na(obStop) ? orLow : obStop) : (na(obStop) ? orHigh : obStop)
                        float target = revDir == 1 ? entryPxR + tickSz * targetTk : entryPxR - tickSz * targetTk
                        if revDir == 1
                            longBreak := true
                            inLong := true
                            entryPx := entryPxR
                            stopPx := stop
                            targetPx := target
                            strategy.entry(sessionLabel + "_Long", strategy.long, qty = contracts, alert_message = f_pmtMessage("buy", contracts))
                            alert('{"secret":"' + secret + '","action":"entry","symbol":"' + sym + '","direction":"LONG","session":"' + sessionLabel + '","strategy":"1m ORB + VWAP","entryPrice":' + str.tostring(entryPxR, format.mintick) + ',"stopPrice":' + str.tostring(stop, format.mintick) + ',"targetPrice":' + str.tostring(target, format.mintick) + ',"contracts":' + str.tostring(contracts) + '}', alert.freq_once_per_bar_close)
                        else
                            shortBreak := true
                            inShort := true
                            entryPx := entryPxR
                            stopPx := stop
                            targetPx := target
                            strategy.entry(sessionLabel + "_Short", strategy.short, qty = contracts, alert_message = f_pmtMessage("sell", contracts))
                            alert('{"secret":"' + secret + '","action":"entry","symbol":"' + sym + '","direction":"SHORT","session":"' + sessionLabel + '","strategy":"1m ORB + VWAP","entryPrice":' + str.tostring(entryPxR, format.mintick) + ',"stopPrice":' + str.tostring(stop, format.mintick) + ',"targetPrice":' + str.tostring(target, format.mintick) + ',"contracts":' + str.tostring(contracts) + '}', alert.freq_once_per_bar_close)
                        tradeTaken := true
                    breakoutDir := 0
                    barsSinceBreakout := na
                else
                    barsSinceBreakout := barsSinceBreakout + 1
            else
                // Candle 3, 4, 5... — watching indefinitely for a close back inside the ORB.
                if closedInsideOrb
                    int revDir = breakoutDir == 1 ? -1 : 1
                    bool vwapOk = revDir == 1 ? vwapOkLong : vwapOkShort
                    if vwapOk and not blockIfInsideOb
                        float entryPxR = close
                        float obStop = revDir == 1 ? f_nearestBullishOB(close) : f_nearestBearishOB(close)
                        float stop = revDir == 1 ? (na(obStop) ? orLow : obStop) : (na(obStop) ? orHigh : obStop)
                        float target = revDir == 1 ? entryPxR + tickSz * targetTk : entryPxR - tickSz * targetTk
                        if revDir == 1
                            longBreak := true
                            inLong := true
                            entryPx := entryPxR
                            stopPx := stop
                            targetPx := target
                            strategy.entry(sessionLabel + "_Long", strategy.long, qty = contracts, alert_message = f_pmtMessage("buy", contracts))
                            alert('{"secret":"' + secret + '","action":"entry","symbol":"' + sym + '","direction":"LONG","session":"' + sessionLabel + '","strategy":"1m ORB + VWAP","entryPrice":' + str.tostring(entryPxR, format.mintick) + ',"stopPrice":' + str.tostring(stop, format.mintick) + ',"targetPrice":' + str.tostring(target, format.mintick) + ',"contracts":' + str.tostring(contracts) + '}', alert.freq_once_per_bar_close)
                        else
                            shortBreak := true
                            inShort := true
                            entryPx := entryPxR
                            stopPx := stop
                            targetPx := target
                            strategy.entry(sessionLabel + "_Short", strategy.short, qty = contracts, alert_message = f_pmtMessage("sell", contracts))
                            alert('{"secret":"' + secret + '","action":"entry","symbol":"' + sym + '","direction":"SHORT","session":"' + sessionLabel + '","strategy":"1m ORB + VWAP","entryPrice":' + str.tostring(entryPxR, format.mintick) + ',"stopPrice":' + str.tostring(stop, format.mintick) + ',"targetPrice":' + str.tostring(target, format.mintick) + ',"contracts":' + str.tostring(contracts) + '}', alert.freq_once_per_bar_close)
                        tradeTaken := true
                    breakoutDir := 0
                    barsSinceBreakout := na
                else
                    barsSinceBreakout := barsSinceBreakout + 1

        else
            if closedAboveOrb or closedBelowOrb
                breakoutDir := closedAboveOrb ? 1 : -1
                barsSinceBreakout := 0

    [longBreak, shortBreak]

[tkLong, tkShort] = f_manageBreakout(tk_switch, tk_open_high, tk_open_low, "TOKYO",    symbolChoice, tickSize, targetTicks, webhookSecret, showTokyo,    breakoutWindowMinutes, forceFlatMinutes, orbContracts, tickDollarValue, trailArmProfit, trailTicks, closedInsideOb)
[shLong, shShort] = f_manageBreakout(sh_switch, sh_open_high, sh_open_low, "SHANGHAI", symbolChoice, tickSize, targetTicks, webhookSecret, showShanghai, breakoutWindowMinutes, forceFlatMinutes, orbContracts, tickDollarValue, trailArmProfit, trailTicks, closedInsideOb)
[ldLong, ldShort] = f_manageBreakout(ld_switch, ld_open_high, ld_open_low, "LONDON",   symbolChoice, tickSize, targetTicks, webhookSecret, showLondon,   breakoutWindowMinutes, forceFlatMinutes, orbContracts, tickDollarValue, trailArmProfit, trailTicks, closedInsideOb)
[nyLong, nyShort] = f_manageBreakout(ny_switch, ny_open_high, ny_open_low, "NEW_YORK", symbolChoice, tickSize, targetTicks, webhookSecret, showNewYork,  breakoutWindowMinutes, forceFlatMinutes, orbContracts, tickDollarValue, trailArmProfit, trailTicks, closedInsideOb)

// ── Chart BUY/SELL markers ───────────────────────────────────────────────────
anyLongEntry  = tkLong or shLong or ldLong or nyLong
anyShortEntry = tkShort or shShort or ldShort or nyShort

plotshape(anyLongEntry, title = "Buy Signal", style = shape.triangleup, location = location.belowbar, color = color.new(color.teal, 0), size = size.small, text = "BUY")
plotshape(anyShortEntry, title = "Sell Signal", style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0), size = size.small, text = "SELL")
