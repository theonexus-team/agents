// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © hundredtoamillion (original opening-range indicator), extended for Theonexus Trading Oracle.
// The order-block detection is a simplified rewrite inspired by "Price Action Toolkit Lite [UAlgo]"
// (© UAlgo), licensed CC BY-NC-SA 4.0: https://creativecommons.org/licenses/by-nc-sa/4.0/ —
// noncommercial use only; if you ever share/publish this script it must carry that license + credit.
//
// !! KEEP THIS SCRIPT PRIVATE — NEVER PUBLISH IT !! Once the webhook secret / PickMyTrade token
// inputs are filled in, they travel in plain text inside every alert message.
//
// ─── WHAT THIS DOES ──────────────────────────────────────────────────────────────────────────────
// Opening-range breakout on Tokyo / Shanghai / London / New York.
//   1. Opening range (OR) = high/low of the first `orMinutes` of each session (sessions use real
//      exchange time zones, so DST is handled automatically).
//   2. After the OR completes, inside the entry window:
//        CONTINUATION — `confirmBars` consecutive closes outside the OR on the same side → enter
//                       in that direction on the last of those closes.
//        REVERSAL     — a close back inside the OR after a close outside → failed breakout, enter
//                       the opposite way on that close.
//   3. Filters: VWAP side (an order-block bounce may override it), skip if the close sits inside an
//      order block, key-level "room to run", daily loss / trade-count limits, one position at a time.
//   4. Risk: ATR-based stop; contracts = min(Contracts, what fits in Max risk $ and the remaining daily
//      loss budget). Target = nearest key level in the trade's direction (skip the trade if that level
//      is closer than Min room R), capped at Max target R.
//   5. Management: break-even at +beAtR, ATR trail after +trailStartR, time exit after forceFlatMinutes.
//      Stops/targets are REAL strategy.exit() orders, so the Strategy Tester, the dashboard and the
//      broker all see the same prices.
//
// ─── ALERT SETUP (two alerts on this script) ─────────────────────────────────────────────────────
//   A) Dashboard: condition = this strategy, "alert() function calls only" → dashboard webhook URL.
//   B) PickMyTrade (optional): condition = this strategy, "Order fills only" → PickMyTrade webhook URL.
//      Entries carry a bracket (sl/tp absolute prices) so the BROKER always holds a protective stop.
//      Verify the field names against PickMyTrade's alert builder for your account before going live.
//
// ─── BACKTEST REALISM ────────────────────────────────────────────────────────────────────────────
// Commission/slippage defaults below are estimates for micros — set your real costs in the strategy's
// Properties tab. Bar magnifier is on (needs a TradingView plan that supports it).
//
// Run on a 1-minute chart (or any intraday timeframe not longer than the OR length).

//@version=5
strategy("Theonexus - ORB Breakout", overlay = true, pyramiding = 0,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     initial_capital = 50000, currency = currency.USD,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.75, slippage = 1,
     process_orders_on_close = true, calc_on_every_tick = false, use_bar_magnifier = true,
     max_bars_back = 1000, max_boxes_count = 50)

// ═════════════════════════════════════ INPUTS ═════════════════════════════════════════════════════
string G_SESS = "Sessions (local exchange time — DST handled)"
tradeTokyo    = input.bool(true, "Trade Tokyo",    inline = "tk", group = G_SESS)
tokyoSess     = input.session("0900-1530", "",     inline = "tk", group = G_SESS)
tokyoTz       = input.string("Asia/Tokyo", "",     inline = "tk", group = G_SESS)
tradeShanghai = input.bool(true, "Trade Shanghai", inline = "sh", group = G_SESS)
shanghaiSess  = input.session("0900-1500", "",     inline = "sh", group = G_SESS)
shanghaiTz    = input.string("Asia/Shanghai", "",  inline = "sh", group = G_SESS)
tradeLondon   = input.bool(true, "Trade London",   inline = "ld", group = G_SESS)
londonSess    = input.session("0800-1630", "",     inline = "ld", group = G_SESS)
londonTz      = input.string("Europe/London", "",  inline = "ld", group = G_SESS)
tradeNewYork  = input.bool(true, "Trade New York", inline = "ny", group = G_SESS)
newyorkSess   = input.session("0930-1600", "",     inline = "ny", group = G_SESS)
newyorkTz     = input.string("America/New_York", "", inline = "ny", group = G_SESS)
showOR        = input.bool(true, "Show opening ranges", group = G_SESS)

string G_ENTRY = "Entry"
orMinutes         = input.int(5, "Opening range length (minutes)", minval = 1, group = G_ENTRY)
entryWindowMin    = input.int(30, "Entry window (minutes after the OR completes)", minval = 1, group = G_ENTRY)
confirmBars       = input.int(2, "Continuation: consecutive closes outside the OR", minval = 1, maxval = 5, group = G_ENTRY)
allowContinuation = input.bool(true, "Take continuation entries", group = G_ENTRY)
allowReversal     = input.bool(true, "Take failed-breakout reversal entries", group = G_ENTRY)
vwapFilter        = input.bool(true, "VWAP filter (longs above / shorts below)", group = G_ENTRY)

string G_RISK = "Risk & exits"
contractsInput  = input.int(8, "Contracts (maximum)", minval = 1, group = G_RISK)
maxRiskUsd      = input.float(300, "Max risk per trade ($) — contracts are reduced to fit", minval = 1, group = G_RISK)
atrLen          = input.int(14, "ATR length", minval = 1, group = G_RISK)
stopAtrMult     = input.float(2.0, "Stop distance (× ATR)", minval = 0.1, step = 0.1, group = G_RISK)
minStopTicks    = input.int(10, "Minimum stop (ticks)", minval = 1, group = G_RISK)
maxRR           = input.float(3.0, "Max target (R) — also the target when no key level applies", minval = 0.5, step = 0.25, group = G_RISK)
useBreakeven    = input.bool(true, "Move stop to break-even", inline = "be", group = G_RISK)
beAtR           = input.float(1.0, "at +R", minval = 0.1, step = 0.1, inline = "be", group = G_RISK)
beOffsetTicks   = input.int(1, "offset ticks", minval = 0, inline = "be", group = G_RISK)
useTrail        = input.bool(true, "ATR trailing stop", inline = "tr", group = G_RISK)
trailStartR     = input.float(1.5, "starts at +R", minval = 0.1, step = 0.1, inline = "tr", group = G_RISK)
trailAtrMult    = input.float(1.5, "× ATR", minval = 0.1, step = 0.1, inline = "tr", group = G_RISK)
forceFlatMinutes = input.int(120, "Time exit (minutes after entry)", minval = 1, group = G_RISK)

string G_DAY = "Daily limits (prop-firm guard rails, 0 = off)"
dailyLossUsd   = input.float(600, "Daily loss limit ($) — also caps the size of the next trade", minval = 0, group = G_DAY)
dailyProfitUsd = input.float(0, "Stop for the day once realized profit reaches ($)", minval = 0, group = G_DAY)
maxTradesDay   = input.int(4, "Max trades per day", minval = 0, group = G_DAY)

string G_LVL = "Key levels (targets + room-to-run filter)"
useKeyLevels      = input.bool(true, "Use key levels for targets", group = G_LVL)
minRoomR          = input.float(1.0, "Min room to the nearest level (R) — closer = skip trade", minval = 0, step = 0.1, group = G_LVL)
targetBufferTicks = input.int(2, "Exit this many ticks in front of the level", minval = 0, group = G_LVL)
lvlPrevDay        = input.bool(true, "Previous day high / low / close", group = G_LVL)
lvlPrevWeek       = input.bool(true, "Previous week high / low", group = G_LVL)
lvlSessions       = input.bool(true, "Last completed session highs / lows", group = G_LVL)
lvlOR             = input.bool(true, "Active opening-range edges", group = G_LVL)
lvlRound          = input.bool(true, "Round numbers", group = G_LVL)
roundStepIn       = input.float(0, "Round-number step (0 = auto per instrument)", minval = 0, group = G_LVL)
showLevels        = input.bool(true, "Plot key levels", group = G_LVL)

string G_OB = "Order blocks"
obEnabled       = input.bool(true, "Use order blocks (inside-block skip + VWAP bounce override)", group = G_OB)
obShowBoxes     = input.bool(true, "Draw order blocks", group = G_OB)
obLen           = input.int(9, "Structure length", minval = 2, group = G_OB)
blockInsideOb   = input.bool(true, "Skip entry if the close is inside an order block", group = G_OB)
obOverrideBars  = input.int(3, "Bounce override window (bars)", minval = 0, group = G_OB)

string G_HOOK = "Dashboard webhook"
webhookSecret = input.string("REPLACE_WITH_YOUR_WEBHOOK_SECRET", "Webhook secret", group = G_HOOK)
strategyName  = input.string("1m ORB + VWAP", "Strategy name sent to the dashboard (must match its allowlist)", group = G_HOOK)

string G_PMT = "PickMyTrade"
pmtEnabled   = input.bool(false, "Relay fills to PickMyTrade", group = G_PMT)
pmtBracket   = input.bool(true, "Send stop/target bracket with the entry", group = G_PMT)
pmtToken     = input.string("", "Token", group = G_PMT)
pmtAccountId = input.string("", "Account ID", group = G_PMT)
pmtAllowed   = input.string("MGC,MNQ,MES,HG,MCL", "Instruments allowed to execute (chart root symbols)", group = G_PMT)

showInfo = input.bool(true, "Show info panel")

// ═════════════════════════════════════ INSTRUMENT ═════════════════════════════════════════════════
// Dollar value of one tick, straight from the contract spec — no hand-maintained table.
float tickValue = syminfo.pointvalue * syminfo.mintick
string pmtSymbol = syminfo.root + "1!"

if barstate.isfirst
    if not timeframe.isintraday or timeframe.in_seconds() > orMinutes * 60
        runtime.error("Use an intraday chart whose timeframe is not longer than the opening range (" + str.tostring(orMinutes) + " min).")
    if pmtEnabled and not str.contains("," + pmtAllowed + ",", "," + syminfo.root + ",")
        runtime.error("PickMyTrade relay is on but " + syminfo.root + " is not in the allowed instrument list.")

f_autoStep() =>
    string r = syminfo.root
    r == "MGC" or r == "GC" ? 10.0 : r == "MNQ" or r == "NQ" ? 50.0 : r == "MES" or r == "ES" ? 10.0 :
      r == "MCL" or r == "CL" ? 0.5 : r == "HG" or r == "MHG" ? 0.05 : syminfo.mintick * 100
float roundStep = roundStepIn > 0 ? roundStepIn : f_autoStep()

// ═════════════════════════════════════ OPENING RANGES ═════════════════════════════════════════════
// Returns the OR, session state, and the high/low of the last COMPLETED session (used as key levels).
f_or(string sess, string tz) =>
    t = time(timeframe.period, sess, tz)
    bool inSess  = not na(t)
    bool isFirst = inSess and na(t[1])
    var float sStart = na
    var float orH = na
    var float orL = na
    var float runH = na
    var float runL = na
    var float lastH = na
    var float lastL = na
    if isFirst
        sStart := time
        orH := high
        orL := low
        runH := high
        runL := low
    else if inSess
        runH := math.max(runH, high)
        runL := math.min(runL, low)
        if time < sStart + orMinutes * 60000
            orH := math.max(orH, high)
            orL := math.min(orL, low)
    if not inSess and not na(t[1])
        lastH := runH
        lastL := runL
    bool orReady = inSess and not na(sStart) and time >= sStart + orMinutes * 60000
    [orH, orL, isFirst, inSess, orReady, sStart, lastH, lastL]

[tkH, tkL, tkFirst, tkIn, tkReady, tkStart, tkLastH, tkLastL] = f_or(tokyoSess, tokyoTz)
[shH, shL, shFirst, shIn, shReady, shStart, shLastH, shLastL] = f_or(shanghaiSess, shanghaiTz)
[ldH, ldL, ldFirst, ldIn, ldReady, ldStart, ldLastH, ldLastL] = f_or(londonSess, londonTz)
[nyH, nyL, nyFirst, nyIn, nyReady, nyStart, nyLastH, nyLastL] = f_or(newyorkSess, newyorkTz)

// ═════════════════════════════════════ KEY LEVELS ═════════════════════════════════════════════════
[pdh, pdl, pdc] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], lookahead = barmerge.lookahead_on)
[pwh, pwl]      = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
float rUp = math.ceil(close / roundStep) * roundStep
float rDn = math.floor(close / roundStep) * roundStep

levels = array.new_float()
if lvlPrevDay
    array.push(levels, pdh)
    array.push(levels, pdl)
    array.push(levels, pdc)
if lvlPrevWeek
    array.push(levels, pwh)
    array.push(levels, pwl)
if lvlSessions
    array.push(levels, tkLastH)
    array.push(levels, tkLastL)
    array.push(levels, shLastH)
    array.push(levels, shLastL)
    array.push(levels, ldLastH)
    array.push(levels, ldLastL)
    array.push(levels, nyLastH)
    array.push(levels, nyLastL)
if lvlOR
    if tkIn and tkReady
        array.push(levels, tkH)
        array.push(levels, tkL)
    if shIn and shReady
        array.push(levels, shH)
        array.push(levels, shL)
    if ldIn and ldReady
        array.push(levels, ldH)
        array.push(levels, ldL)
    if nyIn and nyReady
        array.push(levels, nyH)
        array.push(levels, nyL)
if lvlRound
    array.push(levels, rUp)
    array.push(levels, rUp + roundStep)
    array.push(levels, rDn)
    array.push(levels, rDn - roundStep)

// Nearest level strictly beyond `px` in direction d (+1 above, -1 below).
f_nearest(array<float> lv, int d, float px, float minDist) =>
    float best = na
    for lvl in lv
        if not na(lvl)
            float dist = (lvl - px) * d
            if dist > minDist and (na(best) or dist < (best - px) * d)
                best := lvl
    best

// ═════════════════════════════════════ RISK / SIZING ══════════════════════════════════════════════
float atr = ta.atr(atrLen)
int stopTicks = math.max(minStopTicks, int(math.ceil(nz(atr) * stopAtrMult / syminfo.mintick)))
float riskDist = stopTicks * syminfo.mintick
float riskPerContract = stopTicks * tickValue

// Daily P&L / trade count (the "D" boundary is the exchange trading day, e.g. 18:00 ET for CME).
var float dayStartNet = 0.0
var int dayStartTrades = 0
if timeframe.change("D")
    dayStartNet := strategy.netprofit
    dayStartTrades := strategy.closedtrades + strategy.opentrades
float dayPnl = strategy.netprofit - dayStartNet
int dayTrades = strategy.closedtrades + strategy.opentrades - dayStartTrades
bool dayLocked = (dailyLossUsd > 0 and dayPnl <= -dailyLossUsd) or (dailyProfitUsd > 0 and dayPnl >= dailyProfitUsd) or (maxTradesDay > 0 and dayTrades >= maxTradesDay)

float riskBudget = dailyLossUsd > 0 ? math.min(maxRiskUsd, dailyLossUsd + dayPnl) : maxRiskUsd
int tradeQty = math.min(contractsInput, int(math.floor(math.max(riskBudget, 0) / riskPerContract)))

// Target for a trade entered at this close in direction d; na = no room, skip the trade.
f_target(array<float> lv, int d) =>
    float maxT = close + d * riskDist * maxRR
    float lvl  = useKeyLevels ? f_nearest(lv, d, close, 2 * syminfo.mintick) : na
    float t    = na(lvl) ? na : lvl - d * targetBufferTicks * syminfo.mintick
    float room = na(t) ? na : (t - close) * d
    float res  = na(lvl) ? maxT : room < minRoomR * riskDist ? na : room > maxRR * riskDist ? maxT : t
    na(res) ? na : math.round(res / syminfo.mintick) * syminfo.mintick

float longTgt  = f_target(levels, 1)
float shortTgt = f_target(levels, -1)

// ═════════════════════════════════════ ORDER BLOCKS ═══════════════════════════════════════════════
type OB
    float top
    float bottom
    box bx

var array<OB> bullObs = array.new<OB>()
var array<OB> bearObs = array.new<OB>()
int OB_MAX = 10
int OB_LOOKBACK_MAX = 500

bool swingHigh = high[obLen] >= ta.highest(high, obLen)
bool swingLow  = low[obLen] <= ta.lowest(low, obLen)
var int obTrend = 1
obTrend := obTrend == 1 and swingLow ? -1 : obTrend == -1 and swingHigh ? 1 : obTrend
bool obTrendChanged = obTrend != nz(obTrend[1], obTrend)

var float lastSH = na
var int lastSHBar = na
var bool shUsed = true
var float lastSL = na
var int lastSLBar = na
var bool slUsed = true

if obTrendChanged and obTrend == 1
    lastSH := high[obLen]
    lastSHBar := bar_index - obLen
    shUsed := false
if obTrendChanged and obTrend == -1
    lastSL := low[obLen]
    lastSLBar := bar_index - obLen
    slUsed := false

// Break of structure up → bullish OB = lowest low since the broken swing high (zone height = ATR).
if obEnabled and not shUsed and close > lastSH
    shUsed := true
    int lb = math.min(bar_index - lastSHBar, OB_LOOKBACK_MAX)
    float lo = low
    int loOff = 0
    for i = 0 to lb
        if low[i] < lo
            lo := low[i]
            loOff := i
    float top = lo + atr
    box b = obShowBoxes ? box.new(bar_index - loOff, top, bar_index, lo, border_color = color.new(color.teal, 80), bgcolor = color.new(color.teal, 80)) : na
    array.push(bullObs, OB.new(top, lo, b))
    if array.size(bullObs) > OB_MAX
        OB old = array.shift(bullObs)
        if not na(old.bx)
            box.delete(old.bx)

// Break of structure down → bearish OB = highest high since the broken swing low.
if obEnabled and not slUsed and close < lastSL
    slUsed := true
    int lb = math.min(bar_index - lastSLBar, OB_LOOKBACK_MAX)
    float hi = high
    int hiOff = 0
    for i = 0 to lb
        if high[i] > hi
            hi := high[i]
            hiOff := i
    float bot = hi - atr
    box b = obShowBoxes ? box.new(bar_index - hiOff, hi, bar_index, bot, border_color = color.new(color.red, 80), bgcolor = color.new(color.red, 80)) : na
    array.push(bearObs, OB.new(hi, bot, b))
    if array.size(bearObs) > OB_MAX
        OB old = array.shift(bearObs)
        if not na(old.bx)
            box.delete(old.bx)

// Remove EVERY block price has closed through (not just the newest few).
if array.size(bullObs) > 0
    for i = array.size(bullObs) - 1 to 0
        OB o = array.get(bullObs, i)
        if close < o.bottom
            if not na(o.bx)
                box.delete(o.bx)
            array.remove(bullObs, i)
        else if not na(o.bx)
            box.set_right(o.bx, bar_index)
if array.size(bearObs) > 0
    for i = array.size(bearObs) - 1 to 0
        OB o = array.get(bearObs, i)
        if close > o.top
            if not na(o.bx)
                box.delete(o.bx)
            array.remove(bearObs, i)
        else if not na(o.bx)
            box.set_right(o.bx, bar_index)

bool bullBounceNow = false
bool bearBounceNow = false
bool insideAnyOb = false
for o in bullObs
    if low <= o.top and high >= o.bottom and close > o.top
        bullBounceNow := true
    if close >= o.bottom and close <= o.top
        insideAnyOb := true
for o in bearObs
    if low <= o.top and high >= o.bottom and close < o.bottom
        bearBounceNow := true
    if close >= o.bottom and close <= o.top
        insideAnyOb := true

bool bullBounceRecent = obEnabled and nz(ta.barssince(bullBounceNow), 999999) <= obOverrideBars
bool bearBounceRecent = obEnabled and nz(ta.barssince(bearBounceNow), 999999) <= obOverrideBars

// ═════════════════════════════════════ FILTERS ════════════════════════════════════════════════════
float vwapVal = ta.vwap(hlc3)
bool vwapOkLong  = not vwapFilter or close > vwapVal or bullBounceRecent
bool vwapOkShort = not vwapFilter or close < vwapVal or bearBounceRecent

bool baseOk  = strategy.position_size == 0 and not dayLocked and tradeQty >= 1 and not (obEnabled and blockInsideOb and insideAnyOb)
bool longOk  = baseOk and vwapOkLong and not na(longTgt)
bool shortOk = baseOk and vwapOkShort and not na(shortTgt)

// ═════════════════════════════════════ SIGNAL STATE MACHINE ═══════════════════════════════════════
// One per session. Returns [direction to enter on this bar (+1/-1/0), isReversal].
// `busy` = an earlier session already signalled on this bar (only one entry per bar).
f_signal(bool enabled, bool isFirst, float orH, float orL, bool orReady, float sStart, bool busy) =>
    var int dir = 0
    var int cnt = 0
    var bool taken = false
    if isFirst
        dir := 0
        cnt := 0
        taken := false
    int sig = 0
    bool rev = false
    bool inWindow = orReady and time < sStart + (orMinutes + entryWindowMin) * 60000
    if enabled and inWindow and not taken
        bool above = close > orH
        bool below = close < orL
        if above or below
            int d = above ? 1 : -1
            cnt := d == dir ? cnt + 1 : 1
            dir := d
            if allowContinuation and cnt >= confirmBars
                sig := dir
        else
            if dir != 0 and allowReversal
                sig := -dir
                rev := true
            dir := 0
            cnt := 0
        if sig != 0
            bool ok = not busy and (sig == 1 ? longOk : shortOk)
            taken := ok
            dir := 0
            cnt := 0
            if not ok
                sig := 0
                rev := false
    [sig, rev]

[tkSig, tkRev] = f_signal(tradeTokyo,    tkFirst, tkH, tkL, tkReady, tkStart, false)
[shSig, shRev] = f_signal(tradeShanghai, shFirst, shH, shL, shReady, shStart, tkSig != 0)
[ldSig, ldRev] = f_signal(tradeLondon,   ldFirst, ldH, ldL, ldReady, ldStart, tkSig != 0 or shSig != 0)
[nySig, nyRev] = f_signal(tradeNewYork,  nyFirst, nyH, nyL, nyReady, nyStart, tkSig != 0 or shSig != 0 or ldSig != 0)

int entrySig = tkSig != 0 ? tkSig : shSig != 0 ? shSig : ldSig != 0 ? ldSig : nySig
bool isRev = tkSig != 0 ? tkRev : shSig != 0 ? shRev : ldSig != 0 ? ldRev : nyRev
string sessName = tkSig != 0 ? "TOKYO" : shSig != 0 ? "SHANGHAI" : ldSig != 0 ? "LONDON" : "NEW_YORK"

// ═════════════════════════════════════ ORDERS & ALERTS ════════════════════════════════════════════
f_pmt(string side, int q, float sl, float tp) =>
    string br = pmtBracket and not na(sl) and not na(tp) ? ',"sl":' + str.tostring(sl, format.mintick) + ',"tp":' + str.tostring(tp, format.mintick) : ""
    pmtEnabled ? '{"symbol":"' + pmtSymbol + '","data":"' + side + '","quantity":' + str.tostring(q) + br + ',"token":"' + pmtToken + '","account_id":"' + pmtAccountId + '","order_type":"MKT"}' : ""

var string curId = ""
var float stopPx = na
var float tgtPx = na
var float riskAtEntry = na
var int curQty = 0
var int entryT = 0
var bool timeExitPending = false

// 1) Dashboard exit alert, from the ACTUAL fill.
if strategy.closedtrades > nz(strategy.closedtrades[1])
    float xp = strategy.closedtrades.exit_price(strategy.closedtrades - 1)
    string oc = timeExitPending ? ',"outcome":"CLOSED_AT_DAY_END"' : ""
    alert('{"secret":"' + webhookSecret + '","action":"exit","symbol":"' + syminfo.root + '","timeframe":"' + timeframe.period + '","exitPrice":' + str.tostring(xp, format.mintick) + oc + '}', alert.freq_once_per_bar_close)
    timeExitPending := false

// 2) Manage the open position: break-even, trail, time exit.
if strategy.position_size != 0
    int d = strategy.position_size > 0 ? 1 : -1
    float ep = strategy.position_avg_price
    float gain = (close - ep) * d
    if useBreakeven and gain >= beAtR * riskAtEntry
        float be = ep + d * beOffsetTicks * syminfo.mintick
        stopPx := d == 1 ? math.max(stopPx, be) : math.min(stopPx, be)
    if useTrail and gain >= trailStartR * riskAtEntry
        float tr = math.round((close - d * atr * trailAtrMult) / syminfo.mintick) * syminfo.mintick
        stopPx := d == 1 ? math.max(stopPx, tr) : math.min(stopPx, tr)
    if time - entryT >= forceFlatMinutes * 60000
        timeExitPending := true
        strategy.close(curId, comment = "TIME", alert_message = f_pmt("close", curQty, na, na))
    else
        strategy.exit(curId + "_X", from_entry = curId, stop = stopPx, limit = tgtPx, alert_message = f_pmt("close", curQty, na, na))

// 3) New entry. Entry IDs encode session + type + side so the Strategy Tester's trade list shows which
//    combination actually makes money (e.g. NEW_YORK_REV_S, TOKYO_CONT_L).
if entrySig != 0
    curId := sessName + (isRev ? "_REV" : "_CONT") + (entrySig == 1 ? "_L" : "_S")
    riskAtEntry := riskDist
    stopPx := close - entrySig * riskDist
    tgtPx := entrySig == 1 ? longTgt : shortTgt
    curQty := tradeQty
    entryT := time
    strategy.entry(curId, entrySig == 1 ? strategy.long : strategy.short, qty = tradeQty, alert_message = f_pmt(entrySig == 1 ? "buy" : "sell", tradeQty, stopPx, tgtPx))
    strategy.exit(curId + "_X", from_entry = curId, stop = stopPx, limit = tgtPx, alert_message = f_pmt("close", tradeQty, na, na))
    alert('{"secret":"' + webhookSecret + '","action":"entry","symbol":"' + syminfo.root + '","timeframe":"' + timeframe.period + '","direction":"' + (entrySig == 1 ? "LONG" : "SHORT") + '","session":"' + sessName + '","strategy":"' + strategyName + '","entryPrice":' + str.tostring(close, format.mintick) + ',"stopPrice":' + str.tostring(stopPx, format.mintick) + ',"targetPrice":' + str.tostring(tgtPx, format.mintick) + ',"contracts":' + str.tostring(tradeQty) + '}', alert.freq_once_per_bar_close)

// ═════════════════════════════════════ PLOTS ══════════════════════════════════════════════════════
plot(vwapVal, "VWAP", color = color.new(color.aqua, 0))

ptH = plot(showOR and tkIn ? tkH : na, "Tokyo OR High", color = color.yellow, style = plot.style_linebr)
ptL = plot(showOR and tkIn ? tkL : na, "Tokyo OR Low",  color = color.yellow, style = plot.style_linebr)
fill(ptH, ptL, color = color.new(color.yellow, 85), title = "Tokyo OR")
psH = plot(showOR and shIn ? shH : na, "Shanghai OR High", color = color.orange, style = plot.style_linebr)
psL = plot(showOR and shIn ? shL : na, "Shanghai OR Low",  color = color.orange, style = plot.style_linebr)
fill(psH, psL, color = color.new(color.orange, 85), title = "Shanghai OR")
plH = plot(showOR and ldIn ? ldH : na, "London OR High", color = color.blue, style = plot.style_linebr)
plL = plot(showOR and ldIn ? ldL : na, "London OR Low",  color = color.blue, style = plot.style_linebr)
fill(plH, plL, color = color.new(color.blue, 80), title = "London OR")
pnH = plot(showOR and nyIn ? nyH : na, "New York OR High", color = color.red, style = plot.style_linebr)
pnL = plot(showOR and nyIn ? nyL : na, "New York OR Low",  color = color.red, style = plot.style_linebr)
fill(pnH, pnL, color = color.new(color.red, 80), title = "New York OR")

// Break the line where a level changes value so it doesn't draw vertical joins.
f_br(float x) => x != x[1] ? na : x
color lvlCol = color.new(color.gray, 30)
plot(showLevels and lvlPrevDay ? f_br(pdh) : na, "Prev Day High", color = lvlCol, style = plot.style_linebr, linewidth = 2)
plot(showLevels and lvlPrevDay ? f_br(pdl) : na, "Prev Day Low",  color = lvlCol, style = plot.style_linebr, linewidth = 2)
plot(showLevels and lvlPrevWeek ? f_br(pwh) : na, "Prev Week High", color = color.new(color.purple, 30), style = plot.style_linebr, linewidth = 2)
plot(showLevels and lvlPrevWeek ? f_br(pwl) : na, "Prev Week Low",  color = color.new(color.purple, 30), style = plot.style_linebr, linewidth = 2)
plot(showLevels and lvlSessions ? f_br(tkLastH) : na, "Last Tokyo High",  color = color.new(color.yellow, 50), style = plot.style_linebr)
plot(showLevels and lvlSessions ? f_br(tkLastL) : na, "Last Tokyo Low",   color = color.new(color.yellow, 50), style = plot.style_linebr)
plot(showLevels and lvlSessions ? f_br(ldLastH) : na, "Last London High", color = color.new(color.blue, 50), style = plot.style_linebr)
plot(showLevels and lvlSessions ? f_br(ldLastL) : na, "Last London Low",  color = color.new(color.blue, 50), style = plot.style_linebr)
plot(showLevels and lvlSessions ? f_br(nyLastH) : na, "Last NY High",     color = color.new(color.red, 50), style = plot.style_linebr)
plot(showLevels and lvlSessions ? f_br(nyLastL) : na, "Last NY Low",      color = color.new(color.red, 50), style = plot.style_linebr)

plot(strategy.position_size != 0 ? stopPx : na, "Stop",   color = color.red,  style = plot.style_linebr, linewidth = 2)
plot(strategy.position_size != 0 ? tgtPx : na,  "Target", color = color.lime, style = plot.style_linebr, linewidth = 2)

plotshape(entrySig == 1,  "Buy",  shape.triangleup,   location.belowbar, color.teal, text = "BUY",  size = size.small)
plotshape(entrySig == -1, "Sell", shape.triangledown, location.abovebar, color.red,  text = "SELL", size = size.small)

var table info = table.new(position.top_right, 2, 6, bgcolor = color.new(color.black, 70), border_width = 1)
if showInfo and barstate.islast
    table.cell(info, 0, 0, "Tick value",      text_color = color.white, text_size = size.small)
    table.cell(info, 1, 0, "$" + str.tostring(tickValue), text_color = color.white, text_size = size.small)
    table.cell(info, 0, 1, "Stop (ticks)",    text_color = color.white, text_size = size.small)
    table.cell(info, 1, 1, str.tostring(stopTicks), text_color = color.white, text_size = size.small)
    table.cell(info, 0, 2, "Contracts now",   text_color = color.white, text_size = size.small)
    table.cell(info, 1, 2, str.tostring(tradeQty), text_color = tradeQty >= 1 ? color.white : color.orange, text_size = size.small)
    table.cell(info, 0, 3, "Risk if entered", text_color = color.white, text_size = size.small)
    table.cell(info, 1, 3, "$" + str.tostring(tradeQty * riskPerContract, "#.##"), text_color = color.white, text_size = size.small)
    table.cell(info, 0, 4, "Day P&L",         text_color = color.white, text_size = size.small)
    table.cell(info, 1, 4, "$" + str.tostring(dayPnl, "#.##"), text_color = dayPnl >= 0 ? color.lime : color.red, text_size = size.small)
    table.cell(info, 0, 5, "Day status",      text_color = color.white, text_size = size.small)
    table.cell(info, 1, 5, dayLocked ? "LOCKED" : "open", text_color = dayLocked ? color.orange : color.lime, text_size = size.small)
